# Firebase Web SDK configuration (populate locally in .env — never commit real keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local Firebase Emulator Suite toggle
VITE_USE_EMULATORS=false

# Firebase App Check (optional)
VITE_APPCHECK_DEBUG_TOKEN=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Firebase AI Logic / Gemini model override (defaults to gemini-3.8-flash)
VITE_GEMINI_MODEL=
